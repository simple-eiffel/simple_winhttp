<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="simple_winhttp" uuid="8EAABA31-3056-4D79-B7D8-B225C9A9C875" library_target="simple_winhttp">
	<description>Windows-native HTTPS client (WinHTTP): synchronous exchanges, no redirects, failures as results</description>
	<target name="simple_winhttp">
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\..*$</exclude>
		</file_rule>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<capability>
			<concurrency support="scoop" use="thread"/>
			<void_safety support="all"/>
		</capability>
		<external_include location="$(SIMPLE_EIFFEL)/simple_winhttp/Clib"/>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<cluster name="src" location=".\src\" recursive="true"/>
	</target>
	<target name="simple_winhttp_tests" extends="simple_winhttp">
		<root class="TEST_APP" feature="make"/>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<library name="simple_testing" location="$SIMPLE_EIFFEL/simple_testing/simple_testing.ecf"/>
		<library name="testing" location="$ISE_LIBRARY\library\testing\testing.ecf"/>
		<cluster name="tests" location=".\testing\" recursive="true">
			<file_rule>
				<exclude>/scoop$</exclude>
			</file_rule>
		</cluster>
	</target>
	<!-- The freeze assault (0.1.1). SIMPLE_WINHTTP.c_send is a WAIT, and an unmarked
	     wait stops ISE's collector - and with it every other processor - for as long as
	     it lasts. Proving that needs a second processor allocating while the first is
	     inside the transport, so this target is SCOOP where the others are threads.
	     ISE's net library supplies the raw loopback listener that holds an answer back;
	     every socket external it uses is already marked `C blocking', so the only
	     unmarked wait in the assault is the one under test. -->
	<target name="simple_winhttp_scoop_tests" extends="simple_winhttp">
		<root class="SCOOP_TEST_APP" feature="make"/>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<capability>
			<concurrency use="scoop"/>
		</capability>
		<library name="net" location="$ISE_LIBRARY\library\net\net.ecf"/>
		<cluster name="scoop_tests" location=".\testing\scoop\" recursive="true"/>
	</target>
</system>
